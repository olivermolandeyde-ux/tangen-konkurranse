[Unit]
Description=Tangen Konkurranse Minecraft (port 25566)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/konkurranse
ExecStart=/usr/bin/java -Xms2G -Xmx3G -XX:+UseG1GC -jar paper.jar --nogui
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
